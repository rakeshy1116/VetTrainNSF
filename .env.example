# OpenAI API key used by the Whisper speech-to-text hook
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here

# URL of the Flask backend (defaults to http://localhost:5000 if not set)
REACT_APP_BACKEND_URL=http://localhost:5000

# --- Backend environment variables (set in your shell or server config) ---

# Allowed frontend origin for CORS (defaults to * if not set; restrict in production)
# Example: FRONTEND_ORIGIN=https://your-deployed-frontend.com
FRONTEND_ORIGIN=*

# Flask port (defaults to 5000)
PORT=5000

# Set to "false" to disable Flask debug mode in production
FLASK_DEBUG=true
